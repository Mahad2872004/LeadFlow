# Server-side ONLY. Copy to supabase/.env.local; never use VITE_ for these.
# Hosted Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically.
WEBSITE_OWNER_ID=your-internal-auth-user-uuid
WEBSITE_ID=main-website
INQUIRY_ALLOWED_ORIGINS=https://www.example.com
TURNSTILE_HOSTNAMES=www.example.com
TURNSTILE_SECRET_KEY=configure-cloudflare-secret
EMAIL_HASH_SECRET=generate-at-least-32-random-characters
RESEND_API_KEY=configure-resend-api-key
NOTIFICATION_FROM=LeadFlow <inquiries@example.com>
NOTIFICATION_TO=business@example.com
NOTIFICATION_WORKER_SECRET=generate-at-least-32-random-characters
