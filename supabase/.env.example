# Server-side ONLY. Copy to supabase/.env.local; never use VITE_ for these.
# Hosted Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically.
# Destination workspace ID. A personal workspace's ID is its owner's Auth user UUID.
# Existing deployments may keep the older name WEBSITE_OWNER_ID; WEBSITE_WORKSPACE_ID wins if both are set.
WEBSITE_WORKSPACE_ID=your-workspace-uuid
WEBSITE_ID=main-website
INQUIRY_ALLOWED_ORIGINS=https://www.example.com
TURNSTILE_HOSTNAMES=www.example.com
TURNSTILE_SECRET_KEY=configure-cloudflare-secret
EMAIL_HASH_SECRET=generate-at-least-32-random-characters
RESEND_API_KEY=configure-resend-api-key
NOTIFICATION_FROM=LeadFlow <inquiries@example.com>
NOTIFICATION_TO=business@example.com
NOTIFICATION_WORKER_SECRET=generate-at-least-32-random-characters
# Lead discovery (discover-leads). Off until all three OSM_* values are set; see docs/LEAD-DISCOVERY.md.
# Use servers whose terms allow your use: the public Overpass server is not for commercial backends.
DISCOVERY_ALLOWED_ORIGINS=https://your-leadflow-app.example
OSM_NOMINATIM_URL=https://nominatim.your-host.example/
OSM_OVERPASS_URL=https://overpass.your-host.example/api/interpreter
OSM_USER_AGENT=LeadFlow/1.0 (ops@your-domain.example)
# Hosted Supabase provides SUPABASE_ANON_KEY. Projects with only the new API keys set SUPABASE_PUBLISHABLE_KEY instead.
# Apollo.io (apollo and apollo-webhook functions); see docs/APOLLO.md. Keys stay server-side; never use VITE_ for them.
# Comma-separated label:key pairs. Labels: lowercase letters, numbers, - and _. Or set APOLLO_API_KEY for one account ("default").
APOLLO_API_KEYS=primary:your-apollo-api-key
# Workspaces allowed to use Apollo: comma-separated workspace IDs, or * for all. Your own workspaces only (Apollo's terms).
APOLLO_WORKSPACE_IDS=your-workspace-uuid
# Optional: HTTPS base for Apollo's phone-number webhook. Defaults to SUPABASE_URL.
# APOLLO_WEBHOOK_BASE_URL=https://your-project.supabase.co
