VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-legacy-anon-key

# Public Cloudflare widget site key (never its secret key)
VITE_TURNSTILE_SITE_KEY=your-public-site-key

# Set to true once Supabase Auth allows new sign-ups; switches marketing copy from "request access"
# to "create an account". Leave unset while accounts are by invitation.
# VITE_PUBLIC_SIGNUP=true
# Optional stable deployed form origin; defaults to the current browser origin
# VITE_PUBLIC_FORM_ORIGIN=https://leadflow-tau-five.vercel.app
