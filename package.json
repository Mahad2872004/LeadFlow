{
  "name": "leadflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:production": "vite build --mode test && playwright test --config playwright.production.config.ts",
    "test:db": "node scripts/test-db.mjs",
    "test:m3": "node scripts/test-m3.mjs",
    "check:edge": "tsc -p tsconfig.edge.json",
    "test:integrations": "node scripts/test-integrations.mjs",
    "test:tenancy": "node scripts/test-tenancy.mjs",
    "test:onboarding": "node scripts/test-onboarding.mjs",
    "test:discovery": "node scripts/test-discovery.mjs",
    "directory:load": "node scripts/load-overture.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.4.1-r.4",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
